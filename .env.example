# =============================================================================
# [PT] Manacá — variáveis de ambiente do Docker  (copie para .env: cp .env.example .env)
# [EN] Manacá — Docker environment variables  (copy to .env: cp .env.example .env)
# =============================================================================
# [PT] NUNCA faça commit do .env real (já está no .gitignore). Preencha os segredos.
# [EN] NEVER commit the real .env (it is already in .gitignore). Fill in the secrets.
#
# [PT] IMPORTANTE: o docker compose lê este arquivo via env_file e trata TODO o texto
# após "=" como o valor. NÃO use comentários na mesma linha de uma variável —
# eles entrariam no valor. Mantenha os comentários em linhas próprias, como abaixo.
# [EN] IMPORTANT: docker compose reads this file via env_file and treats ALL text
# after "=" as the value. Do NOT put comments on the same line as a variable —
# they would become part of the value. Keep comments on their own lines, as below.

# [PT] Nome do projeto compose (prefixo de containers/redes)
# [EN] Compose project name (prefix for containers/networks)
COMPOSE_PROJECT_NAME=manaca

# ── [PT] Diretórios no HOST (bind mounts) | [EN] Directories on the HOST (bind mounts) ──
# [PT] Substituem um NFS. Aponte TODOS para um disco com espaço
# suficiente (ex.: /data). IMPORTANTE: use o MESMO disco grande para os três —
# o corpus, os checkpoints e os logs podem somar centenas de GB.
# [EN] They replace an NFS. Point ALL of them to a disk with enough
# space (e.g. /data). IMPORTANT: use the SAME large disk for the three —
# the corpus, the checkpoints and the logs can add up to hundreds of GB.
# [PT] DATA_DIR      -> /workspace/manaca-corpus (WORK_DIR): corpus, tokenizer, stats
# [EN] DATA_DIR      -> /workspace/manaca-corpus (WORK_DIR): corpus, tokenizer, stats
DATA_DIR=/data/manaca/data
# [PT] HF_CACHE_DIR  -> /workspace/hf-cache (HF_HOME)
# [EN] HF_CACHE_DIR  -> /workspace/hf-cache (HF_HOME)
HF_CACHE_DIR=/data/manaca/hf-cache
# [PT] CKPT_DIR      -> /workspace/checkpoints: checkpoints + train_*.log +
# tensorboard/ + provenance_*.txt (TUDO do treino para o artigo científico).
# NÃO deixe em ./checkpoints (fica na home) — aponte para /data.
# [EN] CKPT_DIR      -> /workspace/checkpoints: checkpoints + train_*.log +
# tensorboard/ + provenance_*.txt (EVERYTHING from training for the scientific paper).
# Do NOT leave it at ./checkpoints (stays in home) — point it to /data.
CKPT_DIR=/data/manaca/checkpoints

# ── [PT] Permissões (Linux): evite arquivos root-owned no host | [EN] Permissions (Linux): avoid root-owned files on the host ──
# [PT] Descomente `user:` no docker-compose.yml e defina HOST_UID/HOST_GID:
# [EN] Uncomment `user:` in docker-compose.yml and set HOST_UID/HOST_GID:
# HOST_UID=1000
# HOST_GID=1000

# ── [PT] Credenciais (deixe vazio se não usar; sem comentário na mesma linha!) | [EN] Credentials (leave empty if unused; no comment on the same line!) ──
# [PT] Token HuggingFace (fontes gated: CulturaX, etc.)
# [EN] HuggingFace token (gated sources: CulturaX, etc.)
HF_TOKEN=
# [PT] Weights & Biases (monitoramento de treino)
# [EN] Weights & Biases (training monitoring)
WANDB_API_KEY=
WANDB_PROJECT=manaca-pretrain

# ── [PT] Imagem base GPU | [EN] GPU base image ──────────────────────────────
# [PT] Padrão: NGC PyTorch (CUDA/cuDNN/NCCL/Apex/FlashAttention prontos).
# Alternativa se nvcr.io estiver bloqueado:
#   GPU_BASE_IMAGE=pytorch/pytorch:2.5.1-cuda12.4-cudnn9-devel
# [EN] Default: NGC PyTorch (CUDA/cuDNN/NCCL/Apex/FlashAttention ready).
# Alternative if nvcr.io is blocked:
#   GPU_BASE_IMAGE=pytorch/pytorch:2.5.1-cuda12.4-cudnn9-devel
GPU_BASE_IMAGE=nvcr.io/nvidia/pytorch:24.12-py3

# ── [PT] Megatron-LM (Fase 2b) | [EN] Megatron-LM (Phase 2b) ─────────────────
MEGATRON_REPO=https://github.com/llm-jp/Megatron-LM.git
MEGATRON_REF=nii-geniac

# ── [PT] Pré-treino (Fase 2b) | [EN] Pre-training (Phase 2b) ─────────────────
# [PT] GPUs por nó. DEVE bater com o nº de GPUs físicas (nvidia-smi -L). Ex.: 2× A5000.
# O preset do run_pretrain.sh é fiel ao LLM-jp-3.1-1.8B e ajustado p/ 2 GPUs de
# 24 GB sem NVLink (DP=2, recompute). NÃO coloque mais do que você tem de GPUs.
# [EN] GPUs per node. MUST match the number of physical GPUs (nvidia-smi -L). E.g. 2× A5000.
# The run_pretrain.sh preset is faithful to LLM-jp-3.1-1.8B and tuned for 2 GPUs of
# 24 GB without NVLink (DP=2, recompute). Do NOT set more than the GPUs you have.
GPUS_PER_NODE=2
# [PT] Overrides opcionais (ver comentários no fim de scripts/docker/run_pretrain.sh):
# [EN] Optional overrides (see the comments at the end of scripts/docker/run_pretrain.sh):
#   TRAIN_ITERS=20000       (≈42B de atualização = ~2 épocas do corpus curado de ~20,1B)
#   LR_DECAY_STYLE=cosine    (cosine|constant|linear|inverse-square-root; sem WSD no fork)
#   RECOMPUTE=selective      (use full se der OOM em 24 GB)
#   TP=1  PP=1               (DP=2; TP>1 só faz sentido com NVLink)
# [EN]  TRAIN_ITERS=20000    (≈42B update tokens = ~2 epochs of the ~20.1B curated corpus)
# [EN]  LR_DECAY_STYLE=cosine (cosine|constant|linear|inverse-square-root; no WSD in the fork)
# [EN]  RECOMPUTE=selective   (use full if you hit OOM on 24 GB)
# [EN]  TP=1  PP=1            (DP=2; TP>1 only makes sense with NVLink)
# [PT] Multinó: passe por invocação/nó (NNODES=2 NODE_RANK=1 MASTER_ADDR=<ip> ...).
# [EN] Multi-node: pass per invocation/node (NNODES=2 NODE_RANK=1 MASTER_ADDR=<ip> ...).
