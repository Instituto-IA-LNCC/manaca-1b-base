# =============================================================================
# Manacá — variáveis de ambiente do Docker  (copie para .env: cp .env.example .env)
# =============================================================================
# NUNCA faça commit do .env real (já está no .gitignore). Preencha os segredos.
#
# IMPORTANTE: o docker compose lê este arquivo via env_file e trata TODO o texto
# após "=" como o valor. NÃO use comentários na mesma linha de uma variável —
# eles entrariam no valor. Mantenha os comentários em linhas próprias, como abaixo.

# Nome do projeto compose (prefixo de containers/redes)
COMPOSE_PROJECT_NAME=manaca

# ── Diretórios no HOST (bind mounts) ─────────────────────────────────────────
# Substituem um NFS. Aponte TODOS para um disco com espaço
# suficiente (ex.: /data). IMPORTANTE: use o MESMO disco grande para os três —
# o corpus, os checkpoints e os logs podem somar centenas de GB.
# DATA_DIR      -> /workspace/manaca-corpus (WORK_DIR): corpus, tokenizer, stats
DATA_DIR=/data/manaca/data
# HF_CACHE_DIR  -> /workspace/hf-cache (HF_HOME)
HF_CACHE_DIR=/data/manaca/hf-cache
# CKPT_DIR      -> /workspace/checkpoints: checkpoints + train_*.log +
# tensorboard/ + provenance_*.txt (TUDO do treino para o artigo científico).
# NÃO deixe em ./checkpoints (fica na home) — aponte para /data.
CKPT_DIR=/data/manaca/checkpoints

# ── Permissões (Linux): evite arquivos root-owned no host ───────────────────
# Descomente `user:` no docker-compose.yml e defina HOST_UID/HOST_GID:
# HOST_UID=1000
# HOST_GID=1000

# ── Credenciais (deixe vazio se não usar; sem comentário na mesma linha!) ────
# Token HuggingFace (fontes gated: CulturaX, etc.)
HF_TOKEN=
# Weights & Biases (monitoramento de treino)
WANDB_API_KEY=
WANDB_PROJECT=manaca-pretrain

# ── Imagem base GPU ──────────────────────────────────────────────────────────
# Padrão: NGC PyTorch (CUDA/cuDNN/NCCL/Apex/FlashAttention prontos).
# Alternativa se nvcr.io estiver bloqueado:
#   GPU_BASE_IMAGE=pytorch/pytorch:2.5.1-cuda12.4-cudnn9-devel
GPU_BASE_IMAGE=nvcr.io/nvidia/pytorch:24.12-py3

# ── Megatron-LM (Fase 2b) ────────────────────────────────────────────────────
MEGATRON_REPO=https://github.com/llm-jp/Megatron-LM.git
MEGATRON_REF=nii-geniac

# ── Pré-treino (Fase 2b) ─────────────────────────────────────────────────────
# GPUs por nó. DEVE bater com o nº de GPUs físicas (nvidia-smi -L). Ex.: 2× A5000.
# O preset do run_pretrain.sh é fiel ao LLM-jp-3.1-1.8B e ajustado p/ 2 GPUs de
# 24 GB sem NVLink (DP=2, recompute). NÃO coloque mais do que você tem de GPUs.
GPUS_PER_NODE=2
# Overrides opcionais (ver comentários no fim de scripts/docker/run_pretrain.sh):
#   TRAIN_ITERS=20000       (≈42B de atualização = ~2 épocas do corpus curado de ~20,1B)
#   LR_DECAY_STYLE=cosine    (cosine|constant|linear|inverse-square-root; sem WSD no fork)
#   RECOMPUTE=selective      (use full se der OOM em 24 GB)
#   TP=1  PP=1               (DP=2; TP>1 só faz sentido com NVLink)
# Multinó: passe por invocação/nó (NNODES=2 NODE_RANK=1 MASTER_ADDR=<ip> ...).
